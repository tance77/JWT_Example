<h1>Login</h1>
<form id="login-form" action="/users/login" method="post">
    <label for="username">Username or email</label>
    <input id="username" name="username" autocomplete="username" maxlength="255" required>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="current-password" maxlength="72" required>
    <p id="form-error" role="alert" hidden></p>
    <button type="submit">Login</button>
</form>
