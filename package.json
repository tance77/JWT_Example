{
  "name": "jwt-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env ./bin/www",
    "dev": "node --env-file-if-exists=.env --watch ./bin/www",
    "db:create": "node --env-file-if-exists=.env ./scripts/database.js create",
    "db:migrate": "node --env-file-if-exists=.env ./scripts/database.js migrate",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.6",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  }
}
